{"id": "F12", "parts": ["Fibres of unknown origin were further tested for their tensile strength with tweezers, excluding those that broke with little force.", "Once analysed, the mesh disks were wrapped in aluminium foil, and the liquid with all particles returned to their original container."], "runs": {"release": {"key": "4940eb5a8eaa", "shown": [true, true], "warned": [false, false], "ms": 100, "status": "translated", "details": [], "error": null}, "previous": {"key": "4940eb5a8eaa", "shown": [false, true], "warned": [true, false], "ms": 194, "status": "partial", "details": [[{"code": "negation", "severity": "severe", "detail": ""}], []], "error": null}, "revised": {"key": "4940eb5a8eaa", "shown": [false, true], "warned": [true, false], "ms": 155, "status": "partial", "details": [[{"code": "negation", "severity": "severe", "detail": ""}], []], "error": null}}}
